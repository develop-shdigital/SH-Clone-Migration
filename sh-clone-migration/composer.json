{
	"name": "sh/sh-clone-migration",
	"description": "Complete WordPress website cloning and migration system.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6 || ^10.5 || ^11.0"
	},
	"autoload": {
		"psr-4": {
			"SHCM\\": "includes/"
		}
	},
	"scripts": {
		"test": "phpunit --testsuite unit",
		"test:all": "phpunit"
	},
	"config": {
		"optimize-autoloader": true
	}
}
